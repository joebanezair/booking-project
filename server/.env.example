NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/booking_app
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CLIENT_URL=http://localhost:5173
ADMIN_EMAILS=owner@example.com
ADMIN_REGISTRATION_KEY=replace_with_a_random_secret_at_least_32_characters

# Optional: separate MongoDB GridFS media deployment. Leave unset for legacy Base64 compatibility.
# MEDIA_MONGO_URI=mongodb://127.0.0.1:27018/bookflow_media
# MEDIA_PUBLIC_BASE_URL=https://api.example.com
# MEDIA_SIGNING_SECRET=replace_with_a_random_secret_at_least_32_characters

# TRUST_PROXY=1 (only behind your trusted reverse proxy)
# Local API rate limits are per process; use distributed limits in production.
