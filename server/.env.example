# Copy this file to server/.env, or use the safe Codespaces setup:
#   node scripts/setup-codespaces.mjs
# The setup script generates real secrets without revealing them.
# NEVER commit server/.env, and do not use placeholder secrets for real users.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/booking_app
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_URL=http://localhost:5173

# Leave empty unless you intentionally want to grant admin privileges to an email.
# Existing accounts matching ADMIN_EMAILS may be promoted at server startup.
ADMIN_EMAILS=
ADMIN_REGISTRATION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional second MongoDB instance for GridFS media (local host port 27018).
# Use the Codespaces setup script to create its own credentials and media volume.
# Do not uncomment this without running a compatible media MongoDB service.
# MEDIA_MONGO_URI=mongodb://bookflowmedia:YOUR_MEDIA_PASSWORD@127.0.0.1:27018/bookflow_media?authSource=admin
# MEDIA_SIGNING_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# MEDIA_PUBLIC_BASE_URL=https://api.example.com

# TRUST_PROXY=1 (only behind your trusted reverse proxy)
# Local API rate limits are per process; use distributed limits in production.

# RabbitMQ chat event publication is opt-in; deploy broker AND chat worker.
# RABBITMQ_URL=amqp://bookflow:YOUR_RABBITMQ_PASSWORD@127.0.0.1:5672

# Historical backfills should run only as controlled maintenance operations.
# RUN_LEGACY_MIGRATIONS=1

# Optional main MongoDB connection pool tuning (5–200), default 50.
# MONGO_POOL_MAX=50

# Mongo-backed shared rate counters for multiple API replicas (adds writes).
# Not equivalent to Redis caching or a Socket.IO Redis adapter.
# DISTRIBUTED_RATE_LIMIT=1
