# Default: Vite proxies API and Socket.IO to the Node backend on localhost:5000.
# No client .env is required to run locally or in GitHub Codespaces.
VITE_API_URL=/api

# Keep this unset for the same-origin Vite proxy, especially in Codespaces.
# Set a public HTTPS backend origin only when intentionally bypassing Vite.
# VITE_SOCKET_URL=https://api.example.com
